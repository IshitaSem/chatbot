# Cafe Delight SMTP Environment Variables Configuration
# Copy this file to .env and fill in your real details:
# cp .env.example .env

# Gmail or SMTP sender account
SENDER_EMAIL=your_sender_email@gmail.com

# 16-character Google App Password (not your personal Gmail password)
SENDER_PASSWORD=your_16_character_app_password

# SMTP Server & Port (defaults to smtp.gmail.com:465)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Optional: Cafe admin notification email
# RECEIVER_EMAIL=cafe_admin@gmail.com
